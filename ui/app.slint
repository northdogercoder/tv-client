// Ten-foot launcher window. Design base is 1280x720 (16:9); `base` grows to
// 1080 at a 1080p fullscreen window, and every size below is derived from it.
//
// The window is framed explicitly instead of using one root layout: the
// header and footer have fixed heights and the screen host gets exactly the
// space between them. A screen can therefore never push the footer down; any
// content that does not fit is clipped inside the host and each screen scales
// its own `base` to the host height.

import { CastScreen } from "cast.slint";
import { HomeScreen } from "home.slint";
import { JellyfinItemsScreen, JellyfinLibrariesScreen, JellyfinPreviewScreen, LibraryRow, PosterRow } from "jellyfin.slint";
import { LibraryScreen, MediaCard } from "library.slint";
import { PairDialog } from "pair.slint";
import { PlayerScreen, TrackRow } from "player.slint";
import { SettingsScreen, SettingsRow } from "settings.slint";

export component AppWindow inherits Window {
    title: "tv-client";
    width: 1920px;
    height: 1080px;
    preferred-width: 1920px;
    preferred-height: 1080px;
    background: #0b0e13;

    property <length> base: Math.min(root.width * 9 / 16, root.height);
    // Symmetric overscan inset: `ui_safe_area_percent` percent of the short
    // edge is removed from every side. It is zero by default. The frame keeps
    // the header, screen host and footer aligned at any nonzero value.
    property <length> safe-inset: root.base * root.safe-area-percent / 100;
    property <length> header-height: root.base / 10;
    property <length> footer-height: root.base / 18;

    in-out property <int> screen: 0;
    in-out property <string> status-text: "Choose a source";
    in-out property <string> cloud-status;
    in-out property <string> pair-code;
    in-out property <int> home-focus: 0;
    in-out property <int> library-focus: 0;
    in-out property <int> settings-focus: 0;
    in-out property <int> player-focus: 0;
    in-out property <[MediaCard]> library-items;
    in-out property <string> filter-label: "All sources";
    in-out property <bool> search-active: false;
    in-out property <string> query;
    in-out property <bool> library-loading: false;
    in-out property <bool> library-empty: false;
    in-out property <bool> library-error: false;
    in-out property <string> library-error-text;
    in-out property <bool> next-page-available: false;
    in-out property <string> player-title: "Nothing playing";
    in-out property <string> player-source: "--";
    in-out property <string> player-method;
    in-out property <string> player-position: "0:00 / --:--";
    in-out property <float> player-progress: 0.0;
    in-out property <bool> player-paused: false;
    in-out property <bool> player-loading: false;
    in-out property <string> resume-title;
    in-out property <bool> next-episode-available: false;
    in-out property <bool> retry-available: false;
    in-out property <bool> track-menu-visible: false;
    in-out property <string> track-menu-title;
    in-out property <int> track-focus: 0;
    in-out property <[TrackRow]> track-items;
    in-out property <[LibraryRow]> jf-library-rows;
    in-out property <int> jf-library-focus: 0;
    in-out property <bool> jf-libraries-loading: false;
    in-out property <bool> jf-libraries-empty: false;
    in-out property <bool> jf-libraries-error: false;
    in-out property <string> jf-browse-error;
    in-out property <string> jf-library-name: "Jellyfin";
    in-out property <[PosterRow]> jf-poster-rows;
    in-out property <int> jf-item-focus: 0;
    in-out property <int> jf-item-count: 0;
    in-out property <bool> jf-items-loading: false;
    in-out property <bool> jf-items-empty: false;
    in-out property <bool> jf-items-error: false;
    in-out property <bool> jf-more-available: false;
    in-out property <image> jf-preview-image;
    in-out property <bool> jf-preview-has-image: false;
    in-out property <string> jf-preview-title;
    in-out property <string> jf-preview-subtitle;
    in-out property <string> jf-preview-overview;
    in-out property <int> jf-preview-focus: 0;
    in-out property <bool> jf-preview-playable: false;
    in-out property <bool> jf-preview-planned: false;
    in-out property <string> jf-preview-planned-note;
    in-out property <string> cast-state: "No receiver attached";
    in-out property <string> settings-version;
    in-out property <[SettingsRow]> settings-left;
    in-out property <[SettingsRow]> settings-right;
    in-out property <bool> settings-editing: false;
    in-out property <string> settings-edit-value;
    in-out property <string> settings-message;
    in-out property <string> settings-error;
    in-out property <string> settings-quick-code;
    in-out property <string> jellyfin-user;
    in-out property <int> safe-area-percent: 0;
    in-out property <bool> pair-visible: false;
    in-out property <string> pair-message;
    in-out property <int> pair-choice: 0;

    callback key-pressed(string, bool);
    callback home-activated(int);
    callback library-activated(int);
    callback library-retry-requested();
    callback library-search-requested();
    callback library-more-requested();
    callback player-control-activated(int);
    callback track-activated(int);
    callback jellyfin-library-activated(int);
    callback jellyfin-library-retry-requested();
    callback jellyfin-item-activated(int);
    callback jellyfin-more-requested();
    callback jellyfin-items-retry-requested();
    callback jellyfin-preview-activated(int);
    callback settings-activated(int);
    callback settings-caret-requested(int, float);
    callback pair-choice-activated(int);
    callback back-requested();

    // The safe-area frame. At percent 0 it is the whole window.
    frame := Rectangle {
        x: root.safe-inset;
        y: root.safe-inset;
        width: root.width - 2 * root.safe-inset;
        height: root.height - 2 * root.safe-inset;
        background: transparent;

        Rectangle {
            x: 0;
            y: 0;
            width: parent.width;
            height: root.header-height;
            background: #141a22;

            HorizontalLayout {
                padding-left: root.base / 32;
                padding-right: root.base / 32;
                spacing: root.base / 32;

                Text {
                    text: "tv-client";
                    font-size: root.base / 24;
                    font-weight: 700;
                    color: #f4f7fb;
                    vertical-alignment: center;
                }

                Text {
                    horizontal-stretch: 1;
                    text: root.status-text;
                    font-size: root.base / 30;
                    color: #c6d2e1;
                    vertical-alignment: center;
                    overflow: elide;
                }

                Text {
                    text: "GPL-3.0-only";
                    font-size: root.base / 36;
                    color: #8fa3b8;
                    vertical-alignment: center;
                }
            }
        }

        // Exactly the space between the fixed header and footer. Screens are
        // clipped here, so their contents cannot move the footer. Each screen
        // receives a `base` derived from this host height, which makes rows
        // compact proportionally at 720p and 1080p.
        //
        // 1280x720: base 720, header 72, footer 40, host 608.
        // 1920x1080: base 1080, header 108, footer 60, host 912.
        screen-host := Rectangle {
            x: 0;
            y: root.header-height;
            width: parent.width;
            height: parent.height - root.header-height - root.footer-height;
            clip: true;

            if root.screen == 0 : HomeScreen {
                x: 0;
                y: 0;
                width: parent.width;
                height: parent.height;
                base: Math.min(root.base, screen-host.height);
                focus-index: root.home-focus;
                resume-title: root.resume-title;
                activated(index) => {
                    root.home-activated(index);
                }
            }

            if root.screen == 1 : LibraryScreen {
                x: 0;
                y: 0;
                width: parent.width;
                height: parent.height;
                base: Math.min(root.base, screen-host.height);
                focus-index: root.library-focus;
                items: root.library-items;
                filter-label: root.filter-label;
                query: root.query;
                search-active: root.search-active;
                loading: root.library-loading;
                empty: root.library-empty;
                error: root.library-error;
                error-text: root.library-error-text;
                next-page-available: root.next-page-available;
                activated(index) => {
                    root.library-activated(index);
                }
                retry-requested() => {
                    root.library-retry-requested();
                }
                search-requested() => {
                    root.library-search-requested();
                }
                more-requested() => {
                    root.library-more-requested();
                }
            }

            if root.screen == 2 : PlayerScreen {
                x: 0;
                y: 0;
                width: parent.width;
                height: parent.height;
                base: Math.min(root.base, screen-host.height);
                title: root.player-title;
                source: root.player-source;
                method: root.player-method;
                position: root.player-position;
                progress: root.player-progress;
                paused: root.player-paused;
                loading: root.player-loading;
                next-episode-available: root.next-episode-available;
                retry-available: root.retry-available;
                focus-index: root.player-focus;
                track-menu-visible: root.track-menu-visible;
                track-menu-title: root.track-menu-title;
                track-focus: root.track-focus;
                track-items: root.track-items;
                control-activated(index) => {
                    root.player-control-activated(index);
                }
                track-activated(index) => {
                    root.track-activated(index);
                }
            }

            if root.screen == 3 : SettingsScreen {
                x: 0;
                y: 0;
                width: parent.width;
                height: parent.height;
                base: Math.min(root.base, screen-host.height);
                focus-index: root.settings-focus;
                version: root.settings-version;
                rows-left: root.settings-left;
                rows-right: root.settings-right;
                editing: root.settings-editing;
                edit-value: root.settings-edit-value;
                message: root.settings-message;
                error: root.settings-error;
                quick-code: root.settings-quick-code;
                activated(index) => {
                    root.settings-activated(index);
                }
                caret-requested(index, fraction) => {
                    root.settings-caret-requested(index, fraction);
                }
            }

            if root.screen == 4 : CastScreen {
                x: 0;
                y: 0;
                width: parent.width;
                height: parent.height;
                base: Math.min(root.base, screen-host.height);
                state: root.cast-state;
                back-requested() => {
                    root.back-requested();
                }
            }

            if root.screen == 5 : JellyfinLibrariesScreen {
                x: 0;
                y: 0;
                width: parent.width;
                height: parent.height;
                base: Math.min(root.base, screen-host.height);
                rows: root.jf-library-rows;
                focus-index: root.jf-library-focus;
                loading: root.jf-libraries-loading;
                empty: root.jf-libraries-empty;
                error: root.jf-libraries-error;
                error-text: root.jf-browse-error;
                activated(index) => {
                    root.jellyfin-library-activated(index);
                }
                retry-requested() => {
                    root.jellyfin-library-retry-requested();
                }
            }

            if root.screen == 6 : JellyfinItemsScreen {
                x: 0;
                y: 0;
                width: parent.width;
                height: parent.height;
                base: Math.min(root.base, screen-host.height);
                library-name: root.jf-library-name;
                rows: root.jf-poster-rows;
                focus-index: root.jf-item-focus;
                item-count: root.jf-item-count;
                loading: root.jf-items-loading;
                empty: root.jf-items-empty;
                error: root.jf-items-error;
                error-text: root.jf-browse-error;
                more-available: root.jf-more-available;
                activated(index) => {
                    root.jellyfin-item-activated(index);
                }
                more-requested() => {
                    root.jellyfin-more-requested();
                }
                retry-requested() => {
                    root.jellyfin-items-retry-requested();
                }
            }

            if root.screen == 7 : JellyfinPreviewScreen {
                x: 0;
                y: 0;
                width: parent.width;
                height: parent.height;
                base: Math.min(root.base, screen-host.height);
                preview-image: root.jf-preview-image;
                preview-has-image: root.jf-preview-has-image;
                title: root.jf-preview-title;
                subtitle: root.jf-preview-subtitle;
                overview: root.jf-preview-overview;
                focus-index: root.jf-preview-focus;
                play-enabled: root.jf-preview-playable;
                planned: root.jf-preview-planned;
                planned-note: root.jf-preview-planned-note;
                action-activated(index) => {
                    root.jellyfin-preview-activated(index);
                }
            }
        }

        Rectangle {
            x: 0;
            y: parent.height - root.footer-height;
            width: parent.width;
            height: root.footer-height;
            background: #0e131a;

            HorizontalLayout {
                padding-left: root.base / 32;
                padding-right: root.base / 32;

                Text {
                    text: "ARROWS move    ENTER select    ESC back";
                    font-size: root.base / 38;
                    color: #8fa3b8;
                    vertical-alignment: center;
                }

                Rectangle {
                    horizontal-stretch: 1;
                    background: transparent;
                }

                if root.cloud-status != "" : Text {
                    text: root.cloud-status;
                    font-size: root.base / 34;
                    color: #9fc2ff;
                    vertical-alignment: center;
                }

                if root.pair-code != "" : Text {
                    text: "Pair " + root.pair-code;
                    font-size: root.base / 30;
                    font-weight: 700;
                    color: #ffd479;
                    vertical-alignment: center;
                }

                Text {
                    text: root.search-active ? "SEARCH" : "";
                    font-size: root.base / 38;
                    font-weight: 700;
                    color: #9fc2ff;
                    vertical-alignment: center;
                }
            }
        }
    }

    if root.pair-visible : PairDialog {
        x: 0;
        y: 0;
        width: root.width;
        height: root.height;
        z: 100;
        base: root.base;
        message: root.pair-message;
        choice: root.pair-choice;
        choice-activated(index) => {
            root.pair-choice-activated(index);
        }
    }

    keys := FocusScope {
        x: 0;
        y: 0;
        width: 100%;
        height: 100%;

        key-pressed(event) => {
            root.key-pressed(event.text, event.repeat);
            EventResult.accept
        }
    }

    init => {
        keys.focus();
    }
}
