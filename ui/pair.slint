// Local physical confirmation. Deny is the default and the left-hand button;
// remote input never reaches this component.

export component PairDialog inherits Rectangle {
    in property <length> base: 720px;
    in property <string> message;
    in property <int> choice: 0;

    callback choice-activated(int);

    background: #05070a;

    // Consume presses outside the two buttons. The layout below is declared
    // later and therefore stays on top, so its buttons keep their clicks.
    TouchArea {
        width: 100%;
        height: 100%;
        clicked => {
            // Deliberately inert: outside-button presses must not reach the screen.
        }
    }

    VerticalLayout {
        alignment: center;
        padding: root.base / 12;

        Rectangle {
            height: root.base / 2;
            border-radius: root.base / 70;
            background: #151c25;
            border-width: 4px;
            border-color: #a8c7ff;

            VerticalLayout {
                padding: root.base / 22;
                spacing: root.base / 30;

                Text {
                    height: root.base / 12;
                    text: "Pairing request";
                    font-size: root.base / 13;
                    font-weight: 700;
                    color: #f4f7fb;
                    vertical-alignment: center;
                }

                Text {
                    vertical-stretch: 1;
                    text: root.message;
                    font-size: root.base / 20;
                    color: #e3ebf5;
                    wrap: word-wrap;
                }

                HorizontalLayout {
                    height: root.base / 9;
                    spacing: root.base / 30;

                    Rectangle {
                        horizontal-stretch: 1;
                        border-radius: root.base / 120;
                        background: root.choice == 0 ? #7d1f28 : #10161e;
                        border-width: root.choice == 0 ? 4px : 2px;
                        border-color: root.choice == 0 ? #ff9a9a : #4a5a6e;

                        Text {
                            width: parent.width;
                            height: parent.height;
                            text: "Deny";
                            font-size: root.base / 18;
                            font-weight: root.choice == 0 ? 700 : 400;
                            color: #ffffff;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }

                        TouchArea {
                            width: parent.width;
                            height: parent.height;
                            clicked => {
                                root.choice-activated(0);
                            }
                        }
                    }

                    Rectangle {
                        horizontal-stretch: 1;
                        border-radius: root.base / 120;
                        background: root.choice == 1 ? #1f6feb : #10161e;
                        border-width: root.choice == 1 ? 4px : 2px;
                        border-color: root.choice == 1 ? #a8c7ff : #4a5a6e;

                        Text {
                            width: parent.width;
                            height: parent.height;
                            text: "Allow on this TV";
                            font-size: root.base / 18;
                            font-weight: root.choice == 1 ? 700 : 400;
                            color: #ffffff;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                            overflow: elide;
                        }

                        TouchArea {
                            width: parent.width;
                            height: parent.height;
                            clicked => {
                                root.choice-activated(1);
                            }
                        }
                    }
                }
            }
        }
    }
}
