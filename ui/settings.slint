// Editable on-device settings. Every row is driven by the keyboard focus
// scope in app.slint: Enter edits or activates, arrows move, Escape leaves the
// screen or cancels an edit. Text values are shown through read-only
// TextInputs and toggles through CheckBoxes; the row TouchArea activates the
// focused row so a pointer cannot steal keyboard focus from the overscan-aware
// root scope.

import { CheckBox } from "std-widgets.slint";

export struct SettingsRow {
    index: int,
    label: string,
    value: string,
    kind: int,
    toggle-on: bool,
    editing: bool,
}

component SettingsLine inherits Rectangle {
    in property <SettingsRow> setting;
    in property <string> edit-value;
    in property <int> focus-index;
    in property <length> base;
    callback activated(int);

    height: base / 13;
    border-radius: base / 120;
    background: setting.index == focus-index ? #1f6feb : #151c25;
    border-width: setting.index == focus-index ? 4px : 1px;
    border-color: setting.index == focus-index ? #a8c7ff : #2c3642;

    HorizontalLayout {
        padding-left: base / 40;
        padding-right: base / 40;
        spacing: base / 48;

        Text {
            width: 42%;
            text: setting.label;
            font-size: base / 30;
            font-weight: setting.index == focus-index ? 700 : 400;
            color: #c6d2e1;
            vertical-alignment: center;
            overflow: elide;
        }

        if setting.kind == 0 : TextInput {
            horizontal-stretch: 1;
            read-only: true;
            text: setting.editing ? edit-value : setting.value;
            single-line: true;
            font-size: base / 30;
            color: setting.editing ? #ffd479 : #f4f7fb;
            vertical-alignment: center;
            horizontal-alignment: left;
        }

        if setting.kind == 1 : CheckBox {
            checked: setting.toggle-on;
            enabled: false;
            text: setting.toggle-on ? "On" : "Off";
        }

        if setting.kind == 2 : Text {
            horizontal-stretch: 1;
            text: "< " + setting.value + " >";
            font-size: base / 30;
            color: #f4f7fb;
            vertical-alignment: center;
        }

        if setting.kind == 3 : Text {
            horizontal-stretch: 1;
            text: setting.value;
            font-size: base / 30;
            color: #9fc2ff;
            vertical-alignment: center;
            overflow: elide;
        }
    }

    TouchArea {
        width: parent.width;
        height: parent.height;
        clicked => {
            root.activated(root.setting.index);
        }
    }
}

export component SettingsScreen inherits Rectangle {
    in property <length> base: 720px;
    in property <int> focus-index: 0;
    in property <string> version;
    in property <[SettingsRow]> rows-left;
    in property <[SettingsRow]> rows-right;
    in property <bool> editing: false;
    in property <string> edit-value;
    in property <string> message;
    in property <string> error;
    in property <string> quick-code;

    callback activated(int);

    VerticalLayout {
        padding: root.base / 24;
        spacing: root.base / 70;

        Text {
            height: root.base / 13;
            text: "Settings";
            font-size: root.base / 15;
            font-weight: 700;
            color: #f4f7fb;
            vertical-alignment: center;
        }

        HorizontalLayout {
            spacing: root.base / 20;

            VerticalLayout {
                width: 50%;
                spacing: root.base / 80;

                for entry in root.rows-left : SettingsLine {
                    setting: entry;
                    edit-value: root.edit-value;
                    focus-index: root.focus-index;
                    base: root.base;
                    activated(index) => {
                        root.activated(index);
                    }
                }
            }

            VerticalLayout {
                width: 50%;
                spacing: root.base / 80;

                for entry in root.rows-right : SettingsLine {
                    setting: entry;
                    edit-value: root.edit-value;
                    focus-index: root.focus-index;
                    base: root.base;
                    activated(index) => {
                        root.activated(index);
                    }
                }
            }
        }

        if root.quick-code != "" : Text {
            height: root.base / 18;
            text: "Jellyfin Quick Connect code: " + root.quick-code;
            font-size: root.base / 22;
            font-weight: 700;
            color: #ffd479;
            vertical-alignment: center;
        }

        if root.message != "" : Text {
            height: root.base / 26;
            text: root.message;
            font-size: root.base / 32;
            color: #9fc2ff;
            vertical-alignment: center;
            overflow: elide;
        }

        if root.error != "" : Text {
            height: root.base / 26;
            text: root.error;
            font-size: root.base / 32;
            font-weight: 700;
            color: #ff9a9a;
            vertical-alignment: center;
            overflow: elide;
        }

        Rectangle {
            vertical-stretch: 1;
            background: transparent;
        }

        Text {
            height: root.base / 24;
            text: root.version + "    ARROWS move    ENTER edit/activate    ESC cancel/back";
            font-size: root.base / 36;
            color: #a9b7c8;
            vertical-alignment: center;
        }
    }
}
